{
  "name": "Car Game",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": false
      },
      "Ground": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Material": "Grass",
          "Color": [
            0.30588,
            0.48627,
            0.25098
          ],
          "Position": [
            130,
            -3,
            20
          ],
          "Size": [
            2048,
            4,
            2048
          ],
          "TopSurface": "Smooth"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0.27451,
          0.27451,
          0.27451
        ],
        "Brightness": 2,
        "ClockTime": 14.5,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "ShadowMap"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
